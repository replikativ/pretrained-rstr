{:paths ["src"]
 ;; pretrained-rstr: load & run pretrained HuggingFace decoder-LMs on raster.
 ;; Depends on raster (the typed-dispatch tensor compiler + the dl block library:
 ;; raster.dl.{nn,attention} + raster.quant.*). ALL model-loading (safetensors,
 ;; tokenizers, HF descriptors/engine) lives HERE; the
 ;; compilable blocks + quant kernels stay in raster.
 ;;
 ;; raster is released on Clojars (Maven-resolvable; its POM declares TypedClojure).
 ;; 0.2.545 is the current released Raster baseline. In addition to scoped
 ;; numerical content leases and retained transfer events, it keeps fragmented
 ;; FP16 KV gather/scatter on the typed KernelBody route with bit-exact half
 ;; storage and guarded explicit stores.
 ;; The :dev alias overrides raster with the sibling checkout for local work.
 :deps {org.replikativ/raster {:mvn/version "0.2.545"}
        org.replikativ/boring {:mvn/version "0.1.27"}
        org.replikativ/hasch {:mvn/version "0.4.103"}
        org.replikativ/konserve {:mvn/version "0.9.379"}
        org.replikativ/datahike {:mvn/version "0.8.1777"}
        org.clojure/data.json {:mvn/version "2.5.0"}}

 :aliases
 {:examples {:extra-paths ["dev"]}

  :dev {:extra-paths ["dev" "test"]
        :extra-deps {org.replikativ/raster {:local/root "../raster"}
                     ;; embedding e2e consumers (grid S4 smoke): vector index + umap
                     io.replikativ/proximum {:local/root "../proximum"}
                     io.github.replikativ/umap-rstr {:local/root "../umap-rstr"}
                     criterium/criterium {:mvn/version "0.4.6"}}}

  :valhalla {:jvm-opts ["-XX:ReservedCodeCacheSize=512m" "-Xmx8g" "--enable-preview"
                        "--add-exports" "java.base/jdk.internal.vm.annotation=ALL-UNNAMED"
                        "--add-exports" "java.base/jdk.internal.classfile.components=ALL-UNNAMED"
                        "--add-exports" "java.base/jdk.internal.classfile.impl=ALL-UNNAMED"
                        "--enable-native-access=ALL-UNNAMED"
                        "--add-modules" "jdk.incubator.vector"]}

  ;; Optional executable cluster showcase: a Kabel catalog writer plus two
  ;; worker replicas and an S3-compatible immutable tensor backend. Keeping
  ;; these dependencies out of :deps avoids imposing a server transport or an
  ;; object-store SDK on embedded inference users.
  :distributed-demo
  {:extra-paths ["dev"]
   :extra-deps {org.replikativ/kabel {:mvn/version "0.3.108"}
                is.simm/distributed-scope {:mvn/version "0.1.6"}
                org.replikativ/konserve-sync {:mvn/version "0.1.39"}
                org.replikativ/konserve-s3 {:mvn/version "0.1.38"}
                org.replikativ/http-kit {:mvn/version "2.9.0-beta4-replikativ.1"}}}

  ;; Socket-level tests for the optional distributed demos. Compose with
  ;; `:test:distributed-demo` so ordinary demo consumers do not see test code.
  :distributed-test {:extra-paths ["test-distributed"]}

  ;; Real two-worker Gemma/OpenAI smoke. `run!` performs a conservative host
  ;; resource preflight before loading weights or compiling device programs.
  :real-cluster-test {:extra-paths ["dev"]}

  ;; Optional OpenAI-compatible HTTP/SSE ingress. The replikativ http-kit fork
  ;; exposes outbound queued-byte watermarks used to isolate slow clients from
  ;; the controller and device-owning decode loop.
  :openai-server
  {:extra-deps {org.replikativ/http-kit
                {:mvn/version "2.9.0-beta4-replikativ.1"}}}

  ;; Model-free unit tests. Model-gated tests are ^:anchors-tagged and excluded here
  ;; (they need multi-GB weights and/or a GPU); CI runs exactly `clojure -M:test`.
  :test {:extra-paths ["test" "dev"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.replikativ/http-kit
                      {:mvn/version "2.9.0-beta4-replikativ.1"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                    "--add-modules=jdk.incubator.vector"
                    "-Xss8m"
                    "-XX:ReservedCodeCacheSize=512m"]
         :main-opts ["-m" "cognitect.test-runner" "-e" ":anchors"]}

  :build {:deps {io.github.clojure/tools.build          {:mvn/version "0.10.6"}
                 slipset/deps-deploy                    {:mvn/version "0.2.2"}
                 io.github.borkdude/gh-release-artifact {:git/sha "b946558225a7839f6a0f644834e838e190dc2262"}
                 babashka/babashka.curl                 {:mvn/version "0.1.2"}
                 babashka/fs                            {:mvn/version "0.3.17"}
                 cheshire/cheshire                      {:mvn/version "5.11.0"}}
          :ns-default build}}}
